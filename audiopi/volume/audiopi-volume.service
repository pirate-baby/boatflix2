[Unit]
Description=audiopi volume web page (http://audiopi.local/)
After=network-online.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
# Runs as the audiopi user to reach its PipeWire session (lingering, uid 1000).
User=audiopi
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 -u /usr/local/sbin/audiopi-volume 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
